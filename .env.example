
# PlatformForge - Docker Compose development configuration
#
# Copy this file to .env and configure the values.
#
# PowerShell:
# Copy-Item .env.example .env
#
# Do not commit .env to Git.

# PostgreSQL password for local development.
# Replace this placeholder with your own local password.
POSTGRES_PASSWORD=change_me_local_password

# Database connection used by the API container.
#
# The hostname "postgres" is the Docker Compose service name.
# Keep the password synchronized with POSTGRES_PASSWORD.
#
# If your password contains URL-reserved characters,
# it must be percent-encoded in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://platformforge:change_me_local_password@postgres:5432/platformforge
